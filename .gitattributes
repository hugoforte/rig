# Normalize line endings so committed text is stable across machines
# (core.autocrlf is true globally on this account).
* text=auto
*.md   text eol=lf
*.mjs  text eol=lf
*.ps1  text eol=crlf
# install.sh is handed to bash on Windows too, where a carriage return is a syntax error.
*.sh   text eol=lf
