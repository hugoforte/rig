{
  "name": "@hugoforte/rig",
  "version": "0.0.0-development",
  "type": "module",
  "description": "Cross-repo work harness. Zero dependencies.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/hugoforte/rig.git" },
  "homepage": "https://github.com/hugoforte/rig#readme",
  "bugs": "https://github.com/hugoforte/rig/issues",
  "keywords": ["git", "worktree", "monorepo", "cross-repo", "cli"],
  "engines": { "node": "^18.17.0 || >=20.3.0" },
  "bin": { "rig": "bin/rig.mjs" },
  "files": [
    "bin/",
    "prompts/",
    "templates/",
    "skills/",
    "docs/",
    "AGENTS.md",
    "DESIGN.md",
    "CONTEXT.md"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node -e \"const v = require('./package.json').version; if (v === '0.0.0-development') { console.error('refusing to publish ' + v + ': only the release injects a version (ADR 0004)'); process.exit(1) }\""
  }
}
