# Machine-specific: work root, mirror root, identities, secrets sources.
rig.local.json

# Hard guards. This repo is pushed to GitHub, and the catalogue + work docs are the
# kind of files secrets accidentally land in. Nothing below is ever wanted here.
*.env
.env.*
!*.env.example
!*.env.sample
*.secrets.env
*.local.json
*.pem
*.key
*.pfx

